datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(uuid())
  fullName           String               @map("full_name")
  email              String               @unique
  passwordHash       String               @map("password_hash")
  avatarUrl          String?              @map("avatar_url")
  preferredLanguage  String               @default("id") @map("preferred_language")
  theme              String               @default("dark")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deletedAt          DateTime?            @map("deleted_at")

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  preferences        UserPreferences?
  conversations      Conversation[]
  documents          UploadedDocument[]
  practiceSessions   PracticeSession[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserPreferences {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  responseStyle  String   @default("informative") @map("response_style")
  responseLength String   @default("balanced") @map("response_length")
  voiceEnabled   Boolean  @default(true) @map("voice_enabled")
  voiceSpeed     Float    @default(1.0) @map("voice_speed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @default("Percakapan Baru")
  mode      String    @default("assistant")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  role           String       // user, assistant, system
  content        String       @db.LongText
  status         String       @default("sent") // sending, sent, error
  tokenUsage     Int?         @map("token_usage")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model UploadedDocument {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  originalFilename String          @map("original_filename")
  storageKey       String          @map("storage_key")
  mimeType         String          @map("mime_type")
  fileSize         Int             @map("file_size")
  extractedText    String?         @db.LongText @map("extracted_text")
  processingStatus String          @default("pending") @map("processing_status") // pending, processing, completed, failed
  errorMessage     String?         @map("error_message")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks           DocumentChunk[]

  @@index([userId])
  @@map("uploaded_documents")
}

model DocumentChunk {
  id           String           @id @default(uuid())
  documentId   String           @map("document_id")
  chunkIndex   Int              @map("chunk_index")
  content      String           @db.Text
  metadataJson String?          @db.Text @map("metadata_json")
  createdAt    DateTime         @default(now()) @map("created_at")

  document     UploadedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@map("document_chunks")
}

model PracticeSession {
  id                    String               @id @default(uuid())
  userId                String               @map("user_id")
  title                 String
  practiceType          String               @map("practice_type") // kuliah, seminar, project, kerja, pitching, public_speaking, custom
  topic                 String               @db.Text
  audienceType          String               @map("audience_type") // mentor_ramah, dosen_penguji, manajer_pro, klien, investor, umum
  difficulty            String               @default("intermediate") // beginner, intermediate, advanced
  targetDurationSeconds Int                  @default(300) @map("target_duration_seconds")
  actualDurationSeconds Int?                 @map("actual_duration_seconds")
  language              String               @default("id")
  interactionMode       String               @default("practice") @map("interaction_mode") // practice, interactive, qa
  status                String               @default("draft") // draft, in_progress, completed, cancelled
  startedAt             DateTime?            @map("started_at")
  completedAt           DateTime?            @map("completed_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcripts           PracticeTranscript[]
  questions             PracticeQuestion[]
  evaluations           PracticeEvaluation[]

  @@index([userId])
  @@index([createdAt])
  @@map("practice_sessions")
}

model PracticeTranscript {
  id             String          @id @default(uuid())
  sessionId      String          @map("session_id")
  speaker        String          // user, assistant
  content        String          @db.Text
  sequenceNumber Int             @map("sequence_number")
  startedAt      DateTime?       @map("started_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sequenceNumber])
  @@map("practice_transcripts")
}

model PracticeQuestion {
  id             String          @id @default(uuid())
  sessionId      String          @map("session_id")
  question       String          @db.Text
  userAnswer     String?         @db.Text @map("user_answer")
  feedback       String?         @db.Text
  sequenceNumber Int             @map("sequence_number")
  createdAt      DateTime        @default(now()) @map("created_at")
  answeredAt     DateTime?       @map("answered_at")

  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("practice_questions")
}

model PracticeEvaluation {
  id                String          @id @default(uuid())
  sessionId         String          @map("session_id")
  overallScore      Int?            @map("overall_score")
  summary           String          @db.Text
  evaluationJson    String          @db.LongText @map("evaluation_json")
  strengthsJson     String          @db.LongText @map("strengths_json")
  improvementsJson  String          @db.LongText @map("improvements_json")
  nextPracticeJson  String          @db.LongText @map("next_practice_json")
  evaluationVersion Int             @default(1) @map("evaluation_version")
  createdAt         DateTime        @default(now()) @map("created_at")

  session           PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("practice_evaluations")
}
