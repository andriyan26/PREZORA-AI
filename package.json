{
  "name": "prezora-ai",
  "version": "1.0.0",
  "description": "PREZORA AI — Intelligent AI Assistant & Presentation Coach",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:push": "npm run prisma:push --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "ai",
    "presentation-coach",
    "speech-evaluation",
    "ai-assistant",
    "react",
    "nodejs",
    "express",
    "prisma",
    "mysql"
  ],
  "author": "PREZORA AI Team",
  "license": "MIT"
}
